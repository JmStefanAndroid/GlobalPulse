{
    "name": "global-pulse",
    "version": "1.0.0",
    "description": "全球化多主题消息聚合工具",
    "license": "MIT",
    "author": "GlobalPulse contributors",
    "main": "electron/main.cjs",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "start": "electron .",
        "test": "node --test tests/*.test.cjs",
        "check:feeds": "node scripts/check-feeds.cjs",
        "pack": "electron-builder --mac dir",
        "dist:mac": "electron-builder --mac dmg zip --x64 --publish never"
    },
    "dependencies": {
        "rss-parser": "^3.13.0"
    },
    "devDependencies": {
        "electron": "^42.0.0",
        "electron-builder": "^26.0.12"
    },
    "build": {
        "appId": "com.globalpulse.desktop",
        "productName": "GlobalPulse",
        "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
        "mac": {
            "category": "public.app-category.news"
        },
        "files": [
            "electron/**/*",
            "src/**/*",
            "package.json"
        ],
        "directories": {
            "output": "release"
        }
    }
}